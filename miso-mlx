#!/bin/bash
# Interactive MisoTTS synthesis wizard (Apple Silicon / MLX).
# Resolves its own directory so it works wherever the repo lives.
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$DIR/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
exec "$PY" "$DIR/miso_cli.py" "$@"
